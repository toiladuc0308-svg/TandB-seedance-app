{
  "rewrites": [
    {
      "source": "/gommo-api/(.*)",
      "destination": "https://api.gommo.net/api/apps/go-mmo/$1"
    },
    {
      "source": "/catbox-upload(.*)",
      "destination": "https://catbox.moe/user/api.php"
    },
    {
      "source": "/litterbox-upload(.*)",
      "destination": "https://litterbox.catbox.moe/resources/internals/api.php"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
